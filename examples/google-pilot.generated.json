    {
      "id": "decomposition",
      "template": "decomposition",
      "renderMode": "replace",
      "start": 138.8,
      "end": 167.32,
      "startFrame": 3470,
      "endFrame": 4183,
      "durationFrames": 713,
      "sourceText": "谷歌的优势，在于它不是只拥有一个大模型。最底层是自研TPU芯片和全球数据中心；中间层是DeepMind、Gemini以及模型训练能力；再往上是Google Cloud和Vertex AI；最接近用户的，则是搜索、Android、Chrome、Workspace和YouTube。这些业务一层套一层，让一次模型升级可以迅速进入办公、搜索、手机和云服务。",
      "specFile": "specs/decomposition.json",
      "spec": {
        "whole": "谷歌AI基础设施",
        "events": [
          {
            "at": 4.609,
            "action": "extract",
            "part": "芯片与数据中心",
            "detail": "提供自研算力底座与全球基础设施，支撑模型训练和运行。"
          },
          {
            "at": 9.23,
            "action": "extract",
            "part": "模型与训练",
            "detail": "负责模型研发、Gemini体系建设以及核心训练能力。"
          },
          {
            "at": 12.564,
            "action": "extract",
            "part": "云与AI平台",
            "detail": "将AI能力转化为云平台和企业级开发服务。"
          },
          {
            "at": 16.905,
            "action": "extract",
            "part": "用户产品生态",
            "detail": "把模型升级快速带入搜索、手机、办公、浏览器和视频等用户场景。"
          }
        ]
      }
