{
  "name": "@story-claw/mg-templates",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Schema-driven Remotion MG templates for Story Claw.",
  "exports": {
    ".": "./src/index.ts",
    "./provider": "./src/provider.ts",
    "./runtime": "./src/runtime.ts",
    "./catalog": "./src/catalog.ts",
    "./xy-chart": "./src/xy-chart/index.ts",
    "./progress-timeline": "./src/progress-timeline/index.ts",
    "./directed-graph": "./src/directed-graph/index.ts",
    "./title": "./src/title/index.ts",
    "./emphasis": "./src/emphasis/index.ts",
    "./timed-table": "./src/timed-table/index.ts",
    "./multi-series-chart": "./src/multi-series-chart/index.ts",
    "./containment": "./src/containment/index.ts",
    "./decomposition": "./src/decomposition/index.ts",
    "./weighted-comparison": "./src/weighted-comparison/index.ts",
    "./collage-network": "./src/collage-network/index.ts",
    "./image-stack": "./src/image-stack/index.ts",
    "./image-grid": "./src/image-grid/index.ts",
    "./news-report": "./src/news-report/index.ts",
    "./news-flashback": "./src/news-flashback/index.ts",
    "./era-shift": "./src/era-shift/index.ts",
    "./route-shift": "./src/route-shift/index.ts",
    "./showcase": "./src/showcase/index.ts",
    "./metric": "./src/metric/index.ts",
    "./transition": "./src/transition/index.ts",
    "./rhythm": "./src/rhythm/index.ts",
    "./effect": "./src/effect/index.ts",
    "./sc-longtake": "./src/sc-longtake/index.ts",
    "./video-footage": "./src/video-footage/index.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/xy-chart.test.ts tests/progress-timeline.test.ts tests/directed-graph.test.ts tests/title.test.ts tests/emphasis.test.ts tests/news-flashback.test.ts tests/timed-table.test.ts tests/multi-series-chart.test.ts tests/containment.test.ts tests/decomposition.test.ts tests/weighted-comparison.test.ts tests/collage-network.test.ts tests/image-media.test.ts tests/function-calling.test.ts tests/sc-longtake.test.ts tests/video-footage.test.ts tests/shotcraft-mg.test.ts tests/provider.test.ts tests/era-shift.test.ts",
    "render:previews": "tsx scripts/render-previews.ts",
    "check:previews": "tsx scripts/render-previews.ts --check",
    "gallery": "tsx tools/mg-template-gallery/build-client.ts && tsx tools/mg-template-gallery/server.ts",
    "gallery:portable": "tsx tools/mg-template-gallery/build-gallery.ts --portable"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.512",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/node": "22.15.30",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.512",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
